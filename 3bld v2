// ===== tracing practice =====
const mkPerm=(ax,sg,ly)=>Uint8Array.from(SS.map(t=>ly.includes(t.p[ax])?sIdx(rotv(t.p,ax,sg),rotv(t.n,ax,sg)):sIdx(t.p,t.n)));
Object.assign(PERM,{r:mkPerm(0,1,[0,1]),l:mkPerm(0,-1,[-1,0]),u:mkPerm(1,1,[0,1]),d:mkPerm(1,-1,[-1,0]),f:mkPerm(2,1,[0,1]),b:mkPerm(2,-1,[0,-1]),x:mkPerm(0,1,[-1,0,1]),y:mkPerm(1,1,[-1,0,1]),z:mkPerm(2,1,[-1,0,1])});
const DV={U:[0,1,0],D:[0,-1,0],L:[-1,0,0],R:[1,0,0],F:[0,0,1],B:[0,0,-1]};
const slotOf=nm=>{const p=[0,0,0];for(const ch of nm)DV[ch].forEach((v,i)=>p[i]+=v);return sIdx(p,DV[nm[0]])};
const EDG='UB UR UF UL LU LF LD LB FU FR FD FL RU RB RD RF BU BL BD BR DF DR DB DL'.split(' ').map(slotOf);
const COR='UBL UBR UFR UFL LUB LUF LDF LDB FUL FUR FDR FDL RUF RUB RDB RDF BUR BUL BDL BDR DFL DFR DBR DBL'.split(' ').map(slotOf);
const LET='ABCDEFGHIJKLMNOPQRSTUVWX';
const sameP=s=>SS.map((t,i)=>i).filter(i=>SS[i].p.every((v,k)=>v===SS[s].p[k]));
const cyc=s=>{const o=sameP(s).filter(i=>i!==s);if(o.length===1)return[s,o[0]];const a=SS[s].n,b=SS[o[0]].n,c=SS[o[1]].n,d=(a[1]*b[2]-a[2]*b[1])*c[0]+(a[2]*b[0]-a[0]*b[2])*c[1]+(a[0]*b[1]-a[1]*b[0])*c[2];return d>0?[s,o[0],o[1]]:[s,o[1],o[0]]};
function traceType(st,SL,buf){const cur=Array.from(st),bc=new Set(sameP(buf)),out=[];let g=0;
while(g++<40){const dest=cur[buf];let t;if(bc.has(dest)){const open=SL.filter(s=>!bc.has(s)&&cur[s]!==s);if(!open.length)break;t=open[0]}else t=dest;
out.push(LET[SL.indexOf(t)]);const cb=cyc(buf),ct=cyc(t);for(let i=0;i<cb.length;i++){const x=cur[cb[i]];cur[cb[i]]=cur[ct[i]];cur[ct[i]]=x}}
return{letters:out,bufOk:cur[buf]===buf,solved:SL.every(s=>bc.has(s)||cur[s]===s)}}
function trParse(str){const ms=[];for(let t of str.replace(/[’‘]/g,"'").replace(/[(),]/g,' ').trim().split(/\s+/).filter(Boolean)){t=t.replace(/^([UDLRFB])w/,(a,f)=>f.toLowerCase());const m=t.match(/^([UDLRFBMESudlrfbxyz])(2'?|')?$/);if(!m)throw Error('I don\'t recognise the move "'+t+'".');ms.push({f:m[1],a:m[2]==="'"?3:m[2]?2:1})}return ms}
function trNorm(ms){const ctr=[...SS.keys()].filter(i=>PIECE[i]===1),home=st=>ctr.every(c=>st[c]===c);if(home(gRun(ms)))return ms;const R=['x','y','z'].flatMap(f=>[1,3].map(a=>({f,a})));let lvl=R.map(r=>[r]);for(let d=0;d<3;d++){for(const q of lvl){const t=ms.concat(q);if(home(gRun(t)))return t}lvl=lvl.flatMap(q=>R.map(r=>q.concat(r)))}return ms}
window.trTrace=str=>{const ms=trParse(str);if(!ms.length)throw Error('Enter or generate a scramble first.');const st=gRun(trNorm(ms));return{E:traceType(st,EDG,EDG[20]),C:traceType(st,COR,COR[2])}};
let TR=null;
function trRender(){for(const k of['E','C']){const s=TR[k],el=$('tr'+k);let h=s.letters.slice(0,s.shown).map((l,i)=>`<span class="chip${i>0&&i%2===0?' gap':''}">${l}</span>`).join('');
if(!s.shown&&!s.ended)h='<span class="chip note">Trace it yourself, then press “Next letter”.</span>';if(s.ended)h+=`<span class="chip note">${s.letters.length?'· end of trace':'Already solved, nothing to trace ✓'}</span>`;el.innerHTML=h}
const done=['E','C'].every(k=>TR[k].ended),nE=TR.E.letters.length,nC=TR.C.letters.length;
$('trSummary').textContent=done?`Edges: ${nE} targets · Corners: ${nC} targets · `+((nE%2||nC%2)?'Odd target count, so this scramble has parity.':'No parity.')+(TR.E.bufOk?'':' Edge buffer is flipped.')+(TR.C.bufOk?'':' Corner buffer is twisted.'):''}
window.trStart=()=>{try{TR=trTrace($('trScr').value);for(const k of['E','C'])Object.assign(TR[k],{shown:0,ended:false});$('trMsg').textContent='';if(!$('trStep').checked)trShowAll();else trRender()}catch(e){TR=null;$('trMsg').textContent=e.message}};
window.trNext=k=>{if(!TR){$('trMsg').textContent='Get or paste a scramble first.';return}const s=TR[k];if(s.shown<s.letters.length)s.shown++;else s.ended=true;trRender()};
window.trShowAll=()=>{if(!TR)return;for(const k of['E','C'])Object.assign(TR[k],{shown:TR[k].letters.length,ended:true});trRender()};
window.trHide=()=>{if(!TR)return;for(const k of['E','C'])Object.assign(TR[k],{shown:0,ended:false});trRender()};
window.trToggle=()=>{if(!TR)return;$('trStep').checked?trHide():trShowAll()};
window.trNew=()=>{const t=$('trType').value;let sc;if(t==='full'){const o=[];let l1='',l2='';while(o.length<20){const f=FM[rnd(6)];if(f===l1||(AXC[f]===AXC[l1]&&l2===f))continue;o.push(f+['',"'",'2'][rnd(3)]);l2=l1;l1=f}sc=o.join(' ')}else sc=genScr(t,3,true).s;$('trScr').value=sc;trStart()};
window.trCube=()=>{const v=$('trScr').value.trim();if(v)window.loadIntoCube(v.replace(/([UDLRFB])w/g,(a,f)=>f.toLowerCase()))};
// ===== 1-phase / 2-phase timer =====
let PH=1,memoAt=null;try{PH=+localStorage.getItem('bldclub_phases')||1}catch(e){}
window.setPhases=v=>{PH=+v;try{localStorage.setItem('bldclub_phases',v)}catch(e){}$('phasePill').textContent=PH===2?'SPACE = start · memo done · stop':'SPACE = start / stop'};
const _rst=window.resetTrainingTimer;window.resetTrainingTimer=()=>{memoAt=null;$('splitInfo').textContent='';_rst()};
window.toggleTimer=()=>{if(!timerInterval){window.resetTrainingTimer();window.startTrainingTimer();if(PH===2)$('timerStatus').textContent='Memorising · press Space when done';return}
if(PH===2&&memoAt===null){memoAt=timerElapsed+performance.now()-timerStartedAt;$('splitInfo').textContent='Memo '+fmt(memoAt);$('timerStatus').textContent='Executing · press Space to stop';return}window.stopTrainingTimer()};
const _rt=renderTimes;renderTimes=function(){_rt();const L=times.filter(x=>x.m!=null);$('splitStats').textContent=L.length?`2-phase solves: ${L.length} · average memo ${fmt(L.reduce((a,x)=>a+x.m,0)/L.length)} · average execution ${fmt(L.reduce((a,x)=>a+x.t-x.m,0)/L.length)}`:''};
$('timerPhases').value=PH;setPhases(PH);renderTimes();

// ===== in-page dialogs and sessions (4 types) =====
function ui(msg,o={}){return new Promise(res=>{const d=$('dlg'),inp=$('dlgIn');$('dlgMsg').textContent=msg;inp.style.display=o.input!==undefined?'block':'none';inp.value=o.input||'';$('dlgOk').textContent=o.okLabel||'OK';$('dlgNo').style.display=o.cancel===false?'none':'';d.classList.add('on');setTimeout(()=>o.input!==undefined?(inp.focus(),inp.select()):$('dlgOk').focus(),30);
const end=v=>{d.classList.remove('on');$('dlgOk').onclick=$('dlgNo').onclick=inp.onkeydown=d.onkeydown=null;res(v)};
$('dlgOk').onclick=()=>end(o.input!==undefined?inp.value:true);$('dlgNo').onclick=()=>end(o.input!==undefined?null:false);
d.onkeydown=e=>{if(e.key==='Escape'){e.preventDefault();end(o.input!==undefined?null:false)}else if(e.key==='Enter'&&e.target.tagName!=='BUTTON'){e.preventDefault();end(o.input!==undefined?inp.value:true)}}})}
const MN={C:'Corners',E:'Edges',S:'3×3',B:'3BLD'};
['C','E','S','B'].forEach((m,i)=>{if(!SESS.some(x=>x.mode===m))SESS.push({id:Date.now()+i,name:'Session 1',mode:m,times:[]})});
syncMode=function(){['C','E','S','B'].forEach(m=>$('mode'+m).classList.toggle('primary',MODE===m));$('scrambleLen').style.display=(MODE==='S'||MODE==='B')?'none':''};
const _ns=window.newScramble;
window.newScramble=()=>{if(MODE!=='S'&&MODE!=='B')return _ns();const o=[];let l1='',l2='';while(o.length<20){const f=FM[rnd(6)];if(f===l1||(AXC[f]===AXC[l1]&&l2===f))continue;o.push(f+['',"'",'2'][rnd(3)]);l2=l1;l1=f}$('scrambleText').textContent=o.join(' ');$('scrambleInfo').textContent=(MODE==='B'?'Full 3BLD solve':'Regular 3×3 solve')+' · random 20-move scramble · white on top, green in front'};
window.newSession=async()=>{const n=await ui('Name for the new '+MN[MODE]+' session:',{input:'Session '+(SESS.filter(x=>x.mode===MODE).length+1),okLabel:'Create'});if(!n||!n.trim())return;const s2={id:Date.now(),name:n.trim().slice(0,30),mode:MODE,times:[]};SESS.push(s2);saveTimes();useSession(s2)};
window.renameSession=async()=>{const n=await ui('Rename this session:',{input:curS().name,okLabel:'Rename'});if(n&&n.trim()){curS().name=n.trim().slice(0,30);saveTimes()}};
window.deleteSession=async()=>{const c=curS();if(SESS.filter(x=>x.mode===c.mode).length<2){await ui('Each type needs at least one session. Use "Clear all" to empty this one instead.',{cancel:false});return}if(await ui('Delete "'+c.name+'" and its '+c.times.length+' times?',{okLabel:'Delete'})){SESS=SESS.filter(x=>x!==c);saveTimes();useSession(SESS.filter(x=>x.mode===c.mode).pop())}};
window.clearTimes=async()=>{if(!times.length)return;if(await ui('Delete all '+times.length+' times in this session?',{okLabel:'Clear all'})){times.length=0;saveTimes()}};
saveTimes();syncMode();renderSessions();
</script></body></html>
